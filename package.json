{
    "name": "vscode-pawn",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "1.0.0",
    "publisher": "southclaws",
    "engines": {
        "vscode": "^1.144.0"
    },
    "bugs": {
        "url": "https://github.com/Southclaws/vscode-pawn/issues",
        "email": "hello@southcla.ws"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Southclaws/vscode-pawn.git"
    },
    "icon": "sampctl-icon.png",
    "categories": [
        "Other",
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:pawn"
    ],
    "main": "./out/extension",
    "contributes": {
        "languages": [
            {
                "id": "pawn",
                "aliases": [
                    "Pawn",
                    "pawn"
                ],
                "extensions": [
                    ".p",
                    ".pawn",
                    ".pwn",
                    ".inc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pawn",
                "scopeName": "source.pawn",
                "path": "./syntaxes/Pawn.tmLanguage"
            }
        ],
        "snippets": [
            {
                "language": "pawn",
                "path": "./snippets/macros.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/functions-standard.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/functions-community.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/definitions-standard.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/definitions-community.json"
            }
        ],
        "problemMatchers": [
            {
                "name": "pawncc",
                "owner": "pawn",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^[/\\\\]?(.+?)\\(([0-9]*)[- 0-9]*\\) : (fatal error|error|warning) [0-9]*: (.*)$",
                    "file": 1,
                    "location": 2,
                    "severity": 3,
                    "message": 4
                }
            },
            {
                "name": "sampctl",
                "owner": "pawn",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": [
                    {
                        "regexp": "^[/\\\\]?(.+):([0-9]+) \\((\\w+)\\) (.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "message": 4
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "watch-build: starting compilation",
                    "endsPattern": "watch-build: finished"
                }
            }
        ],
        "commands": [
            {
                "command": "extension.packageEnsure",
                "title": "%command.packageEnsure%"
            },
            {
                "command": "extension.packageBuild",
                "title": "%command.packageBuild%"
            },
            {
                "command": "pawn.showPerformanceStats",
                "title": "%command.showPerformanceStats%"
            },
            {
                "command": "pawn.togglePerformanceLogging",
                "title": "%command.togglePerformanceLogging%"
            },
            {
                "command": "pawn.resetPerformanceStats",
                "title": "%command.resetPerformanceStats%"
            }
        ],
        "configuration": {
            "title": "%configuration.title%",
            "properties": {
                "pawn.includePaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "%setting.includePaths.description%"
                },
                "pawn.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "%setting.compilerPath.description%"
                },
                "pawn.performanceLogging": {
                    "type": "boolean",
                    "default": false,
                    "description": "%setting.performanceLogging.description%"
                },
                "pawn.functionSearchScope": {
                    "type": "string",
                    "enum": [
                        "includes",
                        "compilationUnit",
                        "workspace"
                    ],
                    "enumDescriptions": [
                        "%setting.functionSearchScope.includes%",
                        "%setting.functionSearchScope.compilationUnit%",
                        "%setting.functionSearchScope.workspace%"
                    ],
                    "default": "includes",
                    "description": "%setting.functionSearchScope.description%"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node test/analysis.test.cjs && node test/completion.test.cjs && node test/completionSourceCache.test.cjs && node test/semanticTokensCache.test.cjs && node test/includeGraph.test.cjs && node test/includeConfig.test.cjs && node test/performance.test.cjs"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "@types/node": "^22.20.5",
        "@types/mocha": "^8.2.0",
        "@types/vscode": "1.144.0"
    },
    "dependencies": {
        "vscode-languageclient": "^11.0.0",
        "vscode-languageserver": "^11.0.0",
        "vscode-languageserver-textdocument": "^1.0.16",
        "yaml": "^2.9.1"
    }
}
