{
    "name": "vscode-pawn",
    "displayName": "Pawn Tools",
    "description": "Pawn tools for vscode. Includes syntax highlighting and snippets/completions for common libraries.",
    "version": "1.0.0",
    "publisher": "southclaws",
    "engines": {
        "vscode": "^1.144.0"
    },
    "bugs": {
        "url": "https://github.com/Southclaws/vscode-pawn/issues",
        "email": "hello@southcla.ws"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Southclaws/vscode-pawn.git"
    },
    "icon": "sampctl-icon.png",
    "categories": [
        "Other",
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:pawn"
    ],
    "main": "./out/extension",
    "contributes": {
        "languages": [
            {
                "id": "pawn",
                "aliases": [
                    "Pawn",
                    "pawn"
                ],
                "extensions": [
                    ".p",
                    ".pawn",
                    ".pwn",
                    ".inc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pawn",
                "scopeName": "source.pawn",
                "path": "./syntaxes/Pawn.tmLanguage"
            }
        ],
        "snippets": [
            {
                "language": "pawn",
                "path": "./snippets/macros.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/functions-standard.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/functions-community.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/definitions-standard.json"
            },
            {
                "language": "pawn",
                "path": "./snippets/definitions-community.json"
            }
        ],
        "problemMatchers": [
            {
                "name": "pawncc",
                "owner": "pawn",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^[/\\\\]?(.+?)\\(([0-9]*)[- 0-9]*\\) : (fatal error|error|warning) [0-9]*: (.*)$",
                    "file": 1,
                    "location": 2,
                    "severity": 3,
                    "message": 4
                }
            },
            {
                "name": "sampctl",
                "owner": "pawn",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": [
                    {
                        "regexp": "^[/\\\\]?(.+):([0-9]+) \\((\\w+)\\) (.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "message": 4
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "watch-build: starting compilation",
                    "endsPattern": "watch-build: finished"
                }
            }
        ],
        "commands": [
            {
                "command": "extension.packageEnsure",
                "title": "Ensure Package Dependencies"
            },
            {
                "command": "extension.packageBuild",
                "title": "Build Pawn Package"
            }
        ],
        "configuration": {
            "title": "Pawn Tools",
            "properties": {
                "pawn.includePaths": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Additional Pawn include directories. Relative paths are resolved from each workspace folder."
                },
                "pawn.compilerPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the Pawn compiler executable or its directory. Used to locate the adjacent pawn.cfg and standard include directory."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node test/analysis.test.cjs && node test/includeGraph.test.cjs && node test/includeConfig.test.cjs"
    },
    "devDependencies": {
        "typescript": "^7.0.2",
        "@types/node": "^22.20.5",
        "@types/mocha": "^8.2.0",
        "@types/vscode": "1.144.0"
    },
    "dependencies": {
        "vscode-languageclient": "^11.0.0",
        "vscode-languageserver": "^11.0.0",
        "vscode-languageserver-textdocument": "^1.0.16"
    }
}
